{
  "_comment": "Copy this file to <project-root>/.claude/talend.config.json and fill in the values. Per-project — committed to git. Per-dev / per-machine values (Studio path, JAVA_HOME, PAT) live in env vars set via .claude/settings.local.json (gitignored).",

  "talendProjectName": "YOUR_TALEND_PROJECT",
  "_talendProjectName_help": "The Talend Studio project folder name inside the repo (the folder that contains poms/, process/, joblets/, talend.project, ...). Typical convention: uppercase, e.g. MY_PROJECT.",

  "studioVersion": "8.0.1.20260102_0846-patch",
  "_studioVersion_help": "Documentation only — the live value is parsed from <talendProjectName>/talend.project at build/touch time. Set this if you want to surface the Studio patch level in human-readable docs.",

  "p2UpdateUrl": "https://update.talend.com/Studio/8/updates/latest",
  "_p2UpdateUrl_help": "Talend Studio monthly-update p2 site matching your Studio's patch level. Required at build time so the auto-downloaded headless CommandLine matches Studio. Either a versioned URL like 'https://update.talend.com/Studio/8/updates/R2025-12/', or 'https://update.talend.com/Studio/8/updates/latest'.",

  "tmc": {
    "region": "eu",
    "_region_help": "TMC region: eu / us / us-west / ap / au. The orchestration / processing API base URL is built as https://api.<region>.cloud.talend.com.",

    "publishUrl": "https://tmc.eu.cloud.talend.com/inventory/",
    "_publishUrl_help": "Cloud Publisher service URL (different from the API base). Must end in /inventory/. Tied to the region.",

    "workspace": "your-tmc-workspace",
    "_workspace_help": "TMC workspace name to publish into. The same workspace name typically exists in every env (dev/tst/uat/prd)."
  },

  "envChain": ["dev", "tst", "uat", "prd"],
  "_envChain_help": "Ordered list of env names, source -> target. Used by tooling that needs to know promotion order. Defaults: source 'dev', target 'tst' for /talend-promote and /talend-release."
}
